# Copie para .env e preencha com valores locais. Nunca versionar o .env.
APP_NAME=OrdemFacil
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/ordemfacil
DATABASE_TEST_URL=postgresql+psycopg://usuario:senha@localhost:5432/ordemfacil_test

SECRET_KEY=substitua-por-uma-chave-aleatoria-por-ambiente
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Proteção ao auto cadastro de empresas
SIGNUP_RATE_LIMIT_PER_HOUR=5
